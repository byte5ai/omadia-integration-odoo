{
  "name": "@omadia/integration-odoo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "description": "Odoo integration for Omadia — OdooClient + OdooToolkit factory + per-scope agent-toolkit services + generic read-only tools (odoo_query/odoo_describe/odoo_version) + OdooEntitySync + NorthData/OpenRegister company-enrichment providers + enrich_company tool. Ships as a kind:integration plugin; publishes 'odoo.client', 'odoo.cache', 'odoo.enrich', 'odoo.agentToolkit.*' services.",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs"
  },
  "peerDependencies": {
    "@omadia/plugin-api": "*",
    "@omadia/verifier": "*",
    "undici": "^7.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "@types/node": "^25.6.0",
    "undici": "^7.16.0",
    "zod": "^3.25.76",
    "esbuild": "^0.24.0",
    "@omadia/plugin-api": "file:../odoo-bot/middleware/packages/plugin-api",
    "@omadia/orchestrator": "file:../odoo-bot/middleware/packages/harness-orchestrator",
    "@omadia/verifier": "file:../odoo-bot/middleware/packages/harness-verifier"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/byte5ai/omadia-integration-odoo",
  "repository": {
    "type": "git",
    "url": "https://github.com/byte5ai/omadia-integration-odoo.git"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
